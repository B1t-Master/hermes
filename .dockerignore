# Keep the build context small and never ship secrets.
.git
.gitignore
.github
.venv
venv
env
__pycache__
*.py[cod]
.ruff_cache
.pytest_cache
.mypy_cache

# Node / frontend build output (rebuilt in the image)
node_modules
frontend/node_modules
frontend/dist
frontend/.vite

# Local data + secrets
.env
.env.*
!.env.example
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.log

# Not needed at runtime
docs
tests
