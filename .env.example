# hermes — Kenya Airways RAG Support Bot
# Copy to .env and fill in secrets. Never commit .env.

APP_NAME=hermes Agentic RAG
DEBUG=true
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL + pgvector (local)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hermes
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
KB_CACHE_TTL_SECONDS=300

APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# LLM (Groq or DeepSeek)
GROQ_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=5.0
LLM_MAX_RETRIES=3
LLM_REASONING_EFFORT=low
LLM_MAX_ANSWER_TOKENS=512

# Embeddings & Sentiment (CPU)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
SENTIMENT_ESCALATION_THRESHOLD=-0.75
SENTIMENT_ESCALATION_CONSECUTIVE_TURNS=2
MAX_LOOP_TURNS=3

# Soft escalation: ask before handing off. Hard triggers (safety, explicit
# human request) always escalate immediately. Set SOFT_ESCALATION_ENABLED=false
# to restore escalate-immediately. Compensation escalates immediately unless
# ESCALATE_ON_COMPENSATION=false.
SOFT_ESCALATION_ENABLED=true
SOFT_ESCALATION_MAX_OFFERS=2
ESCALATE_ON_COMPENSATION=true

# Retrieval size (prompt tokens): lower k / cap shrink each request
RETRIEVER_K=3
CONTEXT_MAX_CHARS=0

# Rebooking: official KQ self-service page (offered alongside in-chat rebooking)
SELF_SERVICE_REBOOKING_URL=https://digital.kenya-airways.com/servicing/self-reaccommodation/retrieve

# Baggage guidance: lost / delayed / unclaimed bags (deterministic, in-process)
BAGGAGE_ARRIVAL_CLAIM=JKIA Terminal 1A - Arrivals baggage claim hall
BAGGAGE_LOST_AND_FOUND=JKIA Terminal 1A - Airport Lost & Found desk (Arrivals level)
WORLDTRACER_URL=https://www.worldtracer.aero/

# Agent Auth
AGENT_USERNAME=agent
AGENT_PASSWORD=change-me

# Seed address for the ticket -> email map (confirms only go to mapped tickets)
REBOOK_CONFIRMATION_EMAIL=isaacmwanginjuguna@gmail.com
EMAIL_OUTBOX_DIR=.mock_emails

# Email delivery (Resend). Blank key falls back to the mock outbox.
# The sender must be on a domain verified for the Resend account.
RESEND_API_KEY=
RESEND_FROM_EMAIL=hermes@thestudnet.xyz

# M-Pesa (Safaricom Daraja). provider: auto | daraja | simulated.
# "auto" uses Daraja when the four credentials below are set, otherwise the
# deterministic simulator (a prompt resolves after MPESA_SIMULATE_DELAY_SECONDS;
# numbers ending 0000 fail and 1111 cancel).
MPESA_PROVIDER=auto
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Public HTTPS callback. The path must NOT contain "mpesa" (Safaricom rejects
# those URLs with 400.003.02); /daraja/callback is the supported route.
MPESA_CALLBACK_URL=
# Optional shared secret, appended to the callback URL as ?token=...
MPESA_CALLBACK_SECRET=
MPESA_TIMEOUT_SECONDS=10
MPESA_STK_QUERY_INTERVAL_SECONDS=2
MPESA_STK_QUERY_MAX_ATTEMPTS=60
MPESA_SIMULATE_DELAY_SECONDS=6

# Telegram channel (leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLL_TIMEOUT=25

# Flight data via the hermes-flights MCP server (set false to call in-process)
FLIGHTS_MCP_ENABLED=true
