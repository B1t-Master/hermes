# --- App ---
APP_NAME=hermes Agentic RAG
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database (Neon PostgreSQL with pgvector) ---
# Get a free Neon Postgres URL, then enable the pgvector extension (extension pgvector).
# Use ?ssl=require (not sslmode=); the asyncpg dialect passes URL params as kwargs.
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.region.aws.neon.tech/neondb?ssl=require

# --- LLM providers (at least one) ---
# Primary: Groq (Llama 3.1 8B Instant): https://console.groq.com/
GROQ_API_KEY=
# Fallback / budget: DeepSeek V4 Flash: https://platform.deepseek.com/ (OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_TIMEOUT_SECONDS=5.0
LLM_MAX_RETRIES=3

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Sentiment ---
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
SENTIMENT_ESCALATION_THRESHOLD=-0.75
SENTIMENT_ESCALATION_CONSECUTIVE_TURNS=2
MAX_LOOP_TURNS=3

# --- Agent dashboard (shared credentials for the prototype) ---
AGENT_USERNAME=agent
AGENT_PASSWORD=change-me