# --- App ---
APP_NAME=hermes Agentic RAG
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Deployment / HTTP ---
# development | production. Set DEBUG=false in production.
APP_ENV=development
# Comma-separated browser origins allowed by CORS. Only needed when the
# frontend is served from a different origin than the API (the Docker image
# serves both from one origin, so the local dev default is enough).
CORS_ORIGINS=http://localhost:5173

# --- Database pool (Postgres only) ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# --- Knowledge-base cache ---
# Retrieval is served from an in-process index so a turn never crosses the
# network to the database. The TTL self-heals out-of-band corpus edits
# (seconds); 0 disables it (API mutations always invalidate immediately).
KB_CACHE_TTL_SECONDS=300

# --- Database (Neon PostgreSQL with pgvector) ---
# Get a free Neon Postgres URL, then enable the pgvector extension (extension pgvector).
# Use ?ssl=require (not sslmode=); the asyncpg dialect passes URL params as kwargs.
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.region.aws.neon.tech/neondb?ssl=require

# --- LLM providers (at least one) ---
# Primary: Groq (Llama 3.1 8B Instant): https://console.groq.com/
GROQ_API_KEY=
# Fallback / budget: DeepSeek V4 Flash: https://platform.deepseek.com/ (OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_TIMEOUT_SECONDS=5.0
LLM_MAX_RETRIES=3

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Sentiment ---
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
SENTIMENT_ESCALATION_THRESHOLD=-0.75
SENTIMENT_ESCALATION_CONSECUTIVE_TURNS=2
MAX_LOOP_TURNS=3

# --- Agent dashboard (shared credentials for the prototype) ---
AGENT_USERNAME=agent
AGENT_PASSWORD=change-me

# --- Mock flight delays (MCP) ---
# SQLite cache file for the simulated schedule (regenerated per calendar day).
FLIGHTS_DB_PATH=.flights.sqlite

# --- Retrieval store (default: auto) ---
# auto = pgvector when DATABASE_URL is set, else local sqlite. Force one with
# INGEST_STORE=pg|sqlite. Sandboxes with high Neon latency run better seeded
# locally: python scripts/seed_sqlite_store.py, then INGEST_STORE=sqlite.
INGEST_STORE=auto

# --- App database backend ---
# DATABASE_URL (above) drives BOTH the app database and the retrieval store.
# Schema is created automatically at startup on either backend.
#   Production: the Neon URL above (postgresql+asyncpg://...?ssl=require)
#   Fully-local demo: DATABASE_URL=sqlite+aiosqlite:///./.demo.sqlite